# Copy to `.env` and fill in. `.env` is git-ignored.
# Any variable left unset falls back to a safe local-development default,
# so a laptop can run with an empty/absent .env exactly as before.

# ======================================================================
# GENERAL (all installations)
# ======================================================================
# Turn OFF on the central server. Leave unset (True) for local laptops.
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# DJANGO_SECRET_KEY=change-me
# Comma-separated. Required on the server, e.g. server.example.com
# DJANGO_ALLOWED_HOSTS=server.example.com,www.server.example.com
# Needed for HTTPS POST/CSRF on the server:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://server.example.com

# ======================================================================
# DATABASE — set these ONLY on the central server (uses Postgres).
# Leave unset on laptops to use the local SQLite file (offline-capable).
# ======================================================================
# POSTGRES_DB=equatorial
# POSTGRES_USER=equatorial
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ======================================================================
# SYNC — role of THIS installation.
#   server      = the central authoritative node (do not set SYNC_SERVER_URL)
#   manager     = a laptop that pulls everything and pushes admin changes
#   salesperson = a laptop that pushes its own sales and pulls reference data
#   standalone  = not connected to a server (default)
# ======================================================================
SYNC_ROLE=standalone
# Base URL of the central server (on manager/salesperson laptops):
# SYNC_SERVER_URL=https://server.example.com
# Per-laptop token issued by the server (see: manage.py create_node):
# SYNC_NODE_TOKEN=
# SYNC_HTTP_TIMEOUT=30
# Distinct digit 0-9 for THIS node — the leading digit of invoice numbers minted
# here. MUST be unique per node (server=0, laptops 1,2,3,…) so invoice numbers
# from different laptops can never collide when they sync.
SYNC_NODE_NUMBER=0
